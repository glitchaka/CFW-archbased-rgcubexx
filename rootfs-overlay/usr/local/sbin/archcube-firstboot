#!/usr/bin/env bash
set -euo pipefail

STATE_DIR=/var/lib/archcube
DONE_FILE=${STATE_DIR}/firstboot.done
PACKAGE_LIST=/etc/archcube/packages.txt
EMULATOR_LIST=/etc/archcube/emulators.txt

mkdir -p "${STATE_DIR}"
[[ -e "${DONE_FILE}" ]] && exit 0

# This intentionally fails and is retried by systemd until the bootstrap wired
# connection has Internet access. The base rootfs already contains pacman.
pacman-key --init
pacman-key --populate archlinuxarm
pacman -Syy --noconfirm
mapfile -t packages < <(grep -Ev '^[[:space:]]*(#|$)' "${PACKAGE_LIST}")
pacman -S --needed --noconfirm "${packages[@]}"

# Emulator cores are optional: repository naming/availability can change
# without making the base CFW unbootable.
while IFS= read -r pkg; do
  [[ -z "${pkg}" || "${pkg}" == \#* ]] && continue
  pacman -S --needed --noconfirm "${pkg}" || echo "Optional emulator package unavailable: ${pkg}" >&2
done < "${EMULATOR_LIST}"

systemctl enable NetworkManager.service
systemctl enable bluetooth.service
systemctl enable systemd-timesyncd.service

# NetworkManager takes ownership after bootstrap networking has done its job.
systemctl disable systemd-networkd.service >/dev/null 2>&1 || true
systemctl stop systemd-networkd.service >/dev/null 2>&1 || true
systemctl restart NetworkManager.service || true

for group in wheel input video audio render; do
  getent group "${group}" >/dev/null && usermod -aG "${group}" alarm || true
done

install -d -m0755 \
  /home/alarm/.config/labwc \
  /home/alarm/.config/foot \
  /home/alarm/.config/fuzzel \
  /home/alarm/ROMs
cp -a /usr/share/archcube/labwc/. /home/alarm/.config/labwc/
cp -a /usr/share/archcube/foot/. /home/alarm/.config/foot/
cp -a /usr/share/archcube/fuzzel/. /home/alarm/.config/fuzzel/
install -m0644 /usr/share/archcube/bash_profile /home/alarm/.bash_profile
chown -R alarm:alarm /home/alarm/.config /home/alarm/ROMs /home/alarm/.bash_profile

touch "${DONE_FILE}"
echo "Arch Cube first boot provisioning complete."

# tty1 initially starts as a console while packages are being provisioned.
# Restarting it switches the device into the graphical Arch Cube session.
systemctl try-restart getty@tty1.service || true
