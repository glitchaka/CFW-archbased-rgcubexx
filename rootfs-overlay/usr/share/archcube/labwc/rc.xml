<?xml version="1.0"?>
<labwc_config>
  <core>
    <gap>0</gap>
    <adaptiveSync>yes</adaptiveSync>
  </core>

  <keyboard>
    <keybind key="W-Return">
      <action name="Execute" command="foot" />
    </keybind>
    <keybind key="W-space">
      <action name="Execute" command="fuzzel" />
    </keybind>
    <keybind key="W-q">
      <action name="Close" />
    </keybind>
  </keyboard>

  <windowRules>
    <windowRule identifier="*">
      <action name="Maximize" />
    </windowRule>
  </windowRules>
</labwc_config>
