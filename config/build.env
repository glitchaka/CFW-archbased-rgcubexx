# Arch Cube 0.1 build pins
ARCHCUBE_VERSION="0.1-dev"
DEVICE="rgcubexx"
ARCH="aarch64"

# Arch Linux ARM generic AArch64 userspace
ARCH_ROOTFS_URL="http://os.archlinuxarm.org/os/ArchLinuxARM-aarch64-latest.tar.gz"

# H700 hardware enablement reference. Pinned so builds do not silently change.
ROCKNIX_REPO="https://github.com/ROCKNIX/distribution.git"
ROCKNIX_COMMIT="ca1093d0ae055453fcdd67f5f9515a214230de2c"
ROCKNIX_PROJECT="ROCKNIX"
ROCKNIX_DEVICE="H700"
ROCKNIX_ARCH="aarch64"

# RG CubeXX is LPDDR4; use the H700 DDR4 U-Boot target.
UBOOT_SUBDEVICE="DDR4"
DTB_NAME="sun50i-h700-anbernic-rgcubexx.dtb"

# FAT volume labels are limited to 11 characters.
BOOT_LABEL="ACBOOT"
ROOT_LABEL="ARCHCUBE"
BOOT_SIZE_MIB="512"
IMAGE_SIZE_MIB="8192"
